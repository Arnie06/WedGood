# Copy to .env.local for local development. Never commit real values.
# Only NEXT_PUBLIC_* values are exposed to the browser.

# Public base URL. Optional in development (defaults to http://localhost:3000);
# required in production and must use https.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Auth + Postgres (R0-04). Local values come from `supabase status`
# (API_URL and PUBLISHABLE_KEY); never paste production values into a shared file.
# When unset, /sign-in and /app show an honest "not configured" state.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Private documents (R1-08). SERVER ONLY, never NEXT_PUBLIC_. The service-role key lets the server
# store validated uploads in private storage; without it, uploads show an honest "not available".
# Local value: SECRET_KEY from `supabase status`.
SUPABASE_SECRET_KEY=
# No malware scanner exists yet, so validated uploads are "unscanned" and downloads are refused
# unless this is "true". Leave unset in any shared or production environment.
DOCUMENTS_ALLOW_UNSCANNED_DOWNLOADS=

# UX-06 release switch: "off" hides "One link for all events" and disables party links.
# Per-event links are unaffected. Unset means on.
RSVP_PARTY_LINKS=

# UX-07 release switch: "off" hides the dietary and accessibility questions on guest RSVP links and
# drops any such text on send. Answers already saved stay. Unset means on.
RSVP_GUEST_DETAILS=

# UX-11 release switch: "on" lets the couple add their own questions to each event's guest reply
# (Events and invitations > Guest questions) and asks guests them. Unset or anything else means off.
# Forms and answers already saved stay when it is turned off.
RSVP_FORM_BUILDER=

# UX-15: the HTTP header your host sets to the real client address, used to throttle failed RSVP
# and invitation-link guesses. It must be one the platform overwrites, never a value the browser
# controls, e.g. x-vercel-forwarded-for (Vercel), cf-connecting-ip (Cloudflare), fly-client-ip
# (Fly.io), or x-real-ip set by your own nginx. Required in production: unset there, public links
# show "not available right now". In development, unset uses X-Forwarded-For (spoofable, local only).
CLIENT_IP_HEADER=

# UX-16 release switch: "off" hides "Add to calendar" on the guest's RSVP confirmation. The file is
# built in the guest's browser; nothing is stored. Unset means on.
RSVP_ADD_TO_CALENDAR=

# UX-16 release switch: "on" turns on the couple's guest email outbox (Guests > Guest emails):
# prepare reply confirmations and reminders, read each one, and the owner approves each send.
# Unset or anything else means off. Nothing is delivered without a mail provider.
GUEST_EMAIL=

# UX-16 mail adapter. Only "dev-sink" exists: approved emails are recorded as captured and reach
# no one. A production build ignores it unless MAIL_ALLOW_DEV_SINK=true (the local E2E suite only).
# Unset means email isn't set up and nothing can be sent.
MAIL_PROVIDER=
MAIL_ALLOW_DEV_SINK=

# UX-17 release switch: "on" turns on guest shuttles (an event's page > Shuttles): runs to and from
# each event, attending guests placed on them, and a rider list CSV. Unset or anything else means
# off. Saved shuttles stay when it is turned off; replies keep taking guests off their shuttles.
GUEST_SHUTTLES=

# --- Not used yet; wired and validated in later tickets (see docs/13-DEVOPS.md) ---
# DATABASE_URL=                # migrations/worker only
# R1 optional email delivery (copy-link fallback when unset)
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM=
