# Copy to .env.local for local development. Never commit real values.
# Only NEXT_PUBLIC_* values are exposed to the browser.

# Public base URL. Optional in development (defaults to http://localhost:3000);
# required in production and must use https.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Not used yet; wired and validated in later tickets (see docs/13-DEVOPS.md) ---
# R0-03 local Supabase (values come from `supabase status`, never from production)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # server only, narrow jobs only
# DATABASE_URL=                # migrations/worker only
# R1 optional email delivery (copy-link fallback when unset)
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM=
